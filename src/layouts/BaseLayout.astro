---
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/fraunces/opsz-italic.css';
import '@fontsource-variable/inter/opsz.css';
import '../styles/global.css';

import frauncesLatin from '@fontsource-variable/fraunces/files/fraunces-latin-opsz-normal.woff2?url';
import interLatin from '@fontsource-variable/inter/files/inter-latin-opsz-normal.woff2?url';

import SEO from '../components/SEO.astro';
import AnnouncementBar from '../components/AnnouncementBar.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileActionBar from '../components/MobileActionBar.astro';
import ModeSwitch from '../components/ModeSwitch.astro';
import { withBase } from '../scripts/url';

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  schema?: Record<string, unknown>[];
}

const { title, description, image, noindex, schema } = Astro.props;

// Bump this id when the announcement changes so returning visitors see it again.
const announcementId = 'fall-2026-vermont-castings';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1b1714" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <link rel="preload" href={frauncesLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />

    <script is:inline define:vars={{ announcementId }}>
      document.documentElement.classList.add('js');
      try {
        if (localStorage.getItem('hmi-announcement') === announcementId) {
          document.documentElement.classList.add('announcement-dismissed');
        }
      } catch (e) {}
    </script>

    <script is:inline>
      // Navigating again mid-transition rejects the page transition's promises — nothing to report.
      ['pageswap', 'pagereveal'].forEach((type) =>
        addEventListener(type, (e) => {
          const vt = e.viewTransition;
          if (vt) [vt.ready, vt.finished, vt.updateCallbackDone].forEach((p) => p && p.catch(() => {}));
        }),
      );
    </script>

    <SEO title={title} description={description} image={image} noindex={noindex} schema={schema} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <AnnouncementBar id={announcementId} href={withBase('/#featured')} linkLabel="See the stoves">
      Vermont Castings wood &amp; gas stoves by Forge &amp; Flame are here — in both showrooms.
    </AnnouncementBar>

    <Header />

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <Footer />
    <MobileActionBar />
    <ModeSwitch />

    <script>
      // Reveal-on-scroll for elements marked [data-reveal]
      const reveal = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if ('IntersectionObserver' in window && reveal.length) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        reveal.forEach((el) => io.observe(el));
      } else {
        reveal.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>

<style is:global>
  main:focus {
    outline: none;
  }
</style>
