---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Icon from '../../components/Icon.astro';
import Photo from '../../components/Photo.astro';
import CtaBand from '../../components/CtaBand.astro';
import { team, owners } from '../../data/team';
import { site, yearsInBusiness } from '../../data/site';

import panoStorefront from '../../assets/photos/pano-storefront.jpg';
import family from '../../assets/photos/family-outdoors.jpg';
import { withBase } from '../../scripts/url';

const timeline = [
  { year: '1973', title: 'A move to the Lake', text: 'After several years in medical electronics, Norm Buechting moves his family to the Lake of the Ozarks and gets involved in the hearth industry.' },
  { year: '1975', title: 'The first store', text: 'Norm opens a fireplace store serving builders and homeowners with fireplaces and stucco stone veneer.' },
  { year: '1978', title: 'HMI is born', text: 'The HMI Fireplace Shops name is incorporated. Over the years the company grows to four stores.' },
  { year: '1987', title: 'The next generation', text: 'Norm’s daughter Cheryl begins working in the business day to day — and later helps open the Nixa location.' },
  { year: '1996', title: 'Charlie joins', text: 'Charlie Wormek brings years of sales and sales-management experience to HMI.' },
  { year: 'Today', title: 'Two showrooms, one family', text: 'Cheryl and Charlie have led HMI for more than two decades, with showrooms in Osage Beach and Nixa.' },
];

const principles = [
  { icon: 'shield', title: 'Safe & clean', text: 'A safe, clean environment for our staff and our customers.' },
  { icon: 'heart', title: 'Delighted customers', text: 'Earn — and keep — enthusiastically satisfied customers.' },
  { icon: 'book', title: 'Education first', text: 'Teach customers about every product and service we offer.' },
  { icon: 'award', title: 'Always learning', text: 'Continuing education and certification for every team member.' },
  { icon: 'users', title: 'Knowledge you can trust', text: 'The most knowledgeable sales, service and installation team around.' },
  { icon: 'home', title: 'Good neighbors', text: 'Contribute positively to our community and our environment.' },
  { icon: 'flame', title: 'Built to last', text: 'Run a healthy business so we’re here for the next generation.' },
] as const;
---

<BaseLayout
  title="About HMI Fireplace Shops — Family-Owned Since 1975"
  description="The story of HMI Fireplace Shops: a family business founded at the Lake of the Ozarks in 1975, now led by Cheryl and Charlie Wormek with showrooms in Osage Beach and Nixa, MO."
>
  <PageHero
    title="Our story"
    titleHtml="Family-owned since 1975. <em>Still family-run.</em>"
    eyebrow="About HMI"
    lead={`For ${yearsInBusiness()} years, HMI has helped Missouri families gather around the fire. The names on the trucks have changed a little; the handshake hasn’t.`}
    image={{ src: panoStorefront, alt: '', position: '50% 40%' }}
    crumbs={[{ label: 'About' }]}
  />

  <!-- Story -->
  <section class="section">
    <div class="container story">
      <div class="story__copy prose" data-reveal>
        <p class="eyebrow">The HMI story</p>
        <h2>The hearth is <em>the heart of the home.</em></h2>
        <p class="lead">
          HMI began with one man’s fresh start at the Lake of the Ozarks and grew into a two-generation family business
          built on relationships.
        </p>
        <p>
          Norm Buechting opened his first fireplace store in 1975, serving builders and homeowners with fireplaces and stone
          veneer. The HMI Fireplace Shops name followed in 1978, and the company eventually grew to four stores — two of
          which, Osage Beach and Nixa, carry the name today.
        </p>
        <p>
          Norm’s daughter Cheryl grew up in the business, and together with her husband Charlie she has led HMI for more
          than 20 years. They raised their own family around a wood stove — cutting, stacking and burning wood, and
          gathering for supper by the fire — and they still believe there are few memories more cherished than a family
          together around the hearth.
        </p>
        <p>
          That’s why the whole team treats every customer like a neighbor. Nothing makes Cheryl and Charlie prouder than
          running into longtime customers who share photos of holidays, graduations and even engagements in front of an HMI
          fireplace.
        </p>
      </div>
      <figure class="story__figure" data-reveal style="--reveal-delay: 120ms">
        <div class="media-frame story__frame">
          <Photo src={family} alt="Four people smiling together on a mountain trail" sizes="(min-width: 960px) 520px, 100vw" />
        </div>
        <figcaption>Family-owned, family-run — and always up for an adventure.</figcaption>
      </figure>
    </div>
  </section>

  <!-- Timeline -->
  <section class="section section--dark timeline-section">
    <div class="container">
      <SectionHeading eyebrow="Milestones" title={`${yearsInBusiness()} years <em>in the making.</em>`} align="split" lead="A few of the moments that shaped HMI." />
      <ol class="timeline" role="list">
        {
          timeline.map((t, i) => (
            <li class="timeline__item" data-reveal style={`--reveal-delay: ${i * 80}ms`}>
              <span class="timeline__year">{t.year}</span>
              <h3 class="timeline__title">{t.title}</h3>
              <p class="timeline__text">{t.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Mission -->
  <section class="section section--linen">
    <div class="container">
      <figure class="mission" data-reveal>
        <Icon name="quote" size={36} />
        <blockquote>
          <p>
            To establish HMI Fireplace Shops as the premier fireplace company in the Ozarks, while maintaining the integrity of
            our principles.
          </p>
        </blockquote>
        <figcaption>— The HMI mission</figcaption>
      </figure>

      <div class="principles">
        <h2 class="principles__title" data-reveal>Our seven guiding principles</h2>
        <ol class="principles__list" role="list">
          {
            principles.map((p, i) => (
              <li class="principle" data-reveal style={`--reveal-delay: ${(i % 4) * 70}ms`}>
                <span class="principle__num">{i + 1}</span>
                <span class="icon-tile">
                  <Icon name={p.icon} size={22} />
                </span>
                <h3>{p.title}</h3>
                <p class="muted small">{p.text}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <!-- Owners -->
  <section class="section">
    <div class="container owners">
      <div class="owners__intro" data-reveal>
        <p class="eyebrow">Leadership</p>
        <h2>{owners.names}</h2>
        <p class="owners__role">{owners.role}</p>
      </div>
      <div class="owners__bio prose" data-reveal style="--reveal-delay: 100ms">
        {owners.bio.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>

  <!-- Team preview -->
  <section class="section section--paper">
    <div class="container">
      <SectionHeading
        eyebrow="Meet the team"
        title="Certified, local <em>and easy to talk to.</em>"
        lead="Our installers, technicians and showroom staff hold National Fireplace Institute and manufacturer certifications — and they’re your neighbors."
        align="split"
      >
        <a href={withBase('/about/team/')} class="btn btn--outline">Meet everyone</a>
      </SectionHeading>
      <ul class="team-strip" role="list">
        {
          team.map((m, i) => (
            <li data-reveal style={`--reveal-delay: ${i * 60}ms`}>
              <a href={withBase(`/about/team/#${m.name.toLowerCase().replace(/\s+/g, '-')}`)} class="team-strip__card">
                <span class="team-strip__photo">
                  <Photo src={m.photo} alt="" sizes="200px" widths={[200, 350]} position={m.focus} />
                </span>
                <span class="team-strip__name">{m.name}</span>
                <span class="team-strip__role">{m.role}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Careers -->
  <section class="section section--tight">
    <div class="container">
      <aside class="careers-callout" data-reveal>
        <span class="icon-tile"><Icon name="briefcase" size={24} /></span>
        <div>
          <h2>Want to join the family?</h2>
          <p class="muted">We’re always glad to meet hard-working people who want to learn the hearth trade.</p>
        </div>
        <a href={withBase('/careers/')} class="btn btn--primary">Careers at HMI</a>
      </aside>
    </div>
  </section>

  <CtaBand title={`Come meet us <em>in person.</em>`} text={`Stop by either showroom and you’ll see why families have trusted HMI since ${site.founded}.`} />
</BaseLayout>

<style>
  .story {
    display: grid;
    gap: var(--space-8);
    align-items: center;
  }

  @media (min-width: 960px) {
    .story {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    }
  }

  .story__copy p:not(.eyebrow):not(.lead) {
    color: var(--c-text-muted);
  }

  .story__frame {
    aspect-ratio: 4 / 3;
  }

  .story__figure figcaption {
    margin-top: var(--space-3);
    font-family: var(--font-display);
    font-style: italic;
    color: var(--c-text-muted);
  }

  /* Timeline */
  .timeline {
    position: relative;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 180px), 1fr));
    gap: var(--space-6) var(--space-5);
    padding: 0;
    list-style: none;
  }

  .timeline__item {
    position: relative;
    display: grid;
    align-content: start;
    gap: var(--space-2);
    padding-top: var(--space-6);
    border-top: 1px solid var(--c-ink-line);
  }

  .timeline__item::before {
    content: '';
    position: absolute;
    top: -6px;
    left: 0;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--c-flame);
    box-shadow: 0 0 0 4px rgb(240 160 75 / 0.18);
  }

  .timeline__year {
    font-family: var(--font-display);
    font-size: var(--fs-2xl);
    font-weight: 400;
    line-height: 1;
    color: var(--c-flame);
  }

  .timeline__title {
    font-size: var(--fs-md);
  }

  .timeline__text {
    font-size: var(--fs-sm);
    color: var(--c-text-invert-muted);
  }

  /* Mission */
  .mission {
    display: grid;
    justify-items: center;
    gap: var(--space-4);
    max-width: 900px;
    margin: 0 auto var(--space-9);
    text-align: center;
  }

  .mission :global(svg) {
    color: var(--c-brass);
  }

  .mission blockquote p {
    font-family: var(--font-display);
    font-size: var(--fs-2xl);
    font-weight: 400;
    font-style: italic;
    line-height: 1.3;
    text-wrap: balance;
  }

  .mission figcaption {
    font-size: var(--fs-xs);
    font-weight: 650;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-text-muted);
  }

  .principles__title {
    margin-bottom: var(--space-6);
    font-size: var(--fs-xl);
    text-align: center;
  }

  .principles__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: var(--space-3);
    padding: 0;
    list-style: none;
  }

  .principle {
    position: relative;
    display: grid;
    align-content: start;
    gap: var(--space-3);
    padding: var(--space-6) var(--space-5) var(--space-5);
    background: var(--c-paper);
    border: 1px solid var(--c-stone);
    border-radius: var(--radius-lg);
  }

  .principle__num {
    position: absolute;
    top: var(--space-4);
    right: var(--space-5);
    font-family: var(--font-display);
    font-size: var(--fs-2xl);
    font-style: italic;
    font-weight: 300;
    line-height: 1;
    color: var(--c-brass-text);
  }

  .principle h3 {
    font-size: var(--fs-md);
  }

  /* Owners */
  .owners {
    display: grid;
    gap: var(--space-6);
  }

  @media (min-width: 960px) {
    .owners {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: var(--space-9);
    }
  }

  .owners__intro {
    display: grid;
    gap: var(--space-3);
    align-content: start;
  }

  .owners__role {
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--c-text-muted);
  }

  .owners__bio {
    font-size: var(--fs-md);
    color: var(--c-text-muted);
  }

  /* Team strip */
  .team-strip {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 160px), 1fr));
    gap: var(--space-4);
    padding: 0;
    list-style: none;
  }

  .team-strip__card {
    display: grid;
    gap: 0.2rem;
    color: var(--c-text);
    text-decoration: none;
  }

  .team-strip__photo {
    display: block;
    aspect-ratio: 4 / 5;
    margin-bottom: var(--space-2);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--c-linen);
  }

  .team-strip__photo :global(picture),
  .team-strip__photo :global(img) {
    width: 100%;
    height: 100%;
  }

  .team-strip__photo :global(img) {
    object-fit: cover;
    transition: transform 600ms var(--ease-out);
  }

  .team-strip__card:hover .team-strip__photo :global(img) {
    transform: scale(1.04);
  }

  .team-strip__name {
    font-family: var(--font-display);
    font-size: var(--fs-md);
  }

  .team-strip__card:hover .team-strip__name {
    color: var(--c-ember);
  }

  .team-strip__role {
    font-size: var(--fs-xs);
    color: var(--c-text-muted);
  }

  .careers-callout {
    display: grid;
    gap: var(--space-5);
    align-items: center;
    padding: var(--space-6);
    background: var(--c-paper);
    border: 1px solid var(--c-stone);
    border-radius: var(--radius-lg);
  }

  @media (min-width: 760px) {
    .careers-callout {
      grid-template-columns: auto 1fr auto;
    }
  }

  .careers-callout h2 {
    font-size: var(--fs-lg);
  }
</style>
