---
/**
 * A model page — HMI's own page for every model it carries, so the link a customer has can't go dead. The
 * manufacturer's page is a secondary "Full specs" link through /go/. Discontinued models keep their page, with a
 * notice, the replacement (when the manufacturer names one) and service & parts help.
 */
import type { GetStaticPaths } from 'astro';
import { getImage } from 'astro:assets';
import '../../../../styles/model-page.css';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import Icon from '../../../../components/Icon.astro';
import ProductGallery from '../../../../components/ProductGallery.astro';
import BrandStrip from '../../../../components/BrandStrip.astro';
import ProductCard from '../../../../components/ProductCard.astro';
import SectionHeading from '../../../../components/SectionHeading.astro';
import CtaBand from '../../../../components/CtaBand.astro';
import { brands } from '../../../../data/brands';
import { getCategory, groups, fuelLabels } from '../../../../data/categories';
import { goPath } from '../../../../data/links';
import { linkStatus } from '../../../../data/linkHealth';
import { photosFor } from '../../../../data/productPhotos';
import { brandSites, productById, productPath, productsIn, publicProducts, type Product } from '../../../../data/products';
import { locations, tel, prettyPhone } from '../../../../data/site';
import { withBase } from '../../../../scripts/url';

export const getStaticPaths = (() => publicProducts().map((p) => ({ params: { slug: p.category, model: p.slug }, props: { product: p } }))) satisfies GetStaticPaths;

interface Props {
  product: Product;
}

const { product: p } = Astro.props;
const c = getCategory(p.category);
const group = groups.find((g) => g.id === c.group)!;
const brand = brandSites[p.brand]?.name ?? brands.find((b) => b.id === p.brand)?.name ?? p.brand;
const fullName = `${brand} ${p.model}`;
const discontinued = p.status === 'discontinued';
const replacement = p.replacement?.id ? productById(p.replacement.id) : undefined;

// The latest check decides whether the manufacturer link is worth showing; /go/ handles it either way
const health = linkStatus(p.slug);
const linkDown = health?.target.mode === 'fallback';
const go = withBase(goPath(p.slug));
const linkText = p.linkLabel ? `${p.linkLabel} from ${brand}` : discontinued ? `Owner resources at ${brand}` : `Full specs at ${brand}`;

const host = (u: string) => new URL(u).hostname.replace(/^www\./, '');
const checkedOn = new Intl.DateTimeFormat('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' }).format(new Date(`${p.verified.on}T12:00:00Z`));

const quoteHref = withBase(`/contact/?interest=${p.category}&model=${encodeURIComponent(p.id)}`);
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const serviceHref = withBase(`/service-request/?brand=${encodeURIComponent(brand)}&model=${encodeURIComponent(p.model)}`);

const stores = locations.map((l) => ({ ...l, count: p.display[l.slug as keyof typeof p.display] ?? 0 }));
const shownAt = stores.filter((s) => s.count > 0).map((s) => s.shortName);

// Other models HMI sells in the category, the same brand's first
const others = productsIn(p.category)
  .filter((x) => x.id !== p.id && x.status === 'current')
  .sort((a, b) => Number(b.brand === p.brand) - Number(a.brand === p.brand))
  .slice(0, 3);

const canonical = new URL(withBase(productPath(p)), Astro.site).toString();
// The first photo, when the model has one, is also its image in structured data and link previews
const lead = photosFor(p)[0];
const leadImage = lead ? await getImage({ src: lead.src, width: Math.min(1200, lead.src.width), format: 'jpg' }) : undefined;
const productLd = {
  '@type': 'Product',
  name: fullName,
  brand: { '@type': 'Brand', name: brand },
  model: p.model,
  image: new URL(leadImage?.src ?? withBase(`${productPath(p)}photo.svg`), Astro.site).toString(),
  description: p.summary,
  category: c.name,
  url: canonical,
  ...(p.specs.length ? { additionalProperty: p.specs.map((s) => ({ '@type': 'PropertyValue', name: s.label, value: s.value })) } : {}),
};

const description = discontinued
  ? `${fullName}: no longer made. HMI Fireplace Shops services ${p.model} ${p.type.toLowerCase()}s in Osage Beach and Nixa, MO.`
  : `${p.summary}${shownAt.length ? ` On display at HMI Fireplace Shops in ${shownAt.join(' and ')}, MO.` : ' Ask HMI Fireplace Shops in Osage Beach or Nixa, MO.'}`;
---

<BaseLayout title={`${fullName} ${p.type}`} description={description} image={leadImage?.src} schema={[productLd]}>
  <section class="mhero on-dark" data-listing-page={p.id}>
    <div class="container mhero__inner">
      <div class="mhero__text">
        <Breadcrumbs
          items={[
            { label: 'Products', href: withBase('/products/') },
            { label: c.name, href: withBase(`/products/${c.slug}/`) },
            { label: p.model },
          ]}
          class="mhero__crumbs"
        />
        <p class="eyebrow">{brand}</p>
        <h1 data-listing-name>{fullName}</h1>
        <p class="lead" data-listing-summary>{p.summary}</p>
        <ul class="cluster mhero__chips" role="list">
          {p.fuel && <li class="chip">{fuelLabels[p.fuel]}</li>}
          <li class="chip" data-listing-page-type>{p.type}</li>
          {discontinued && <li class="chip mhero__chip--gone">No longer made</li>}
        </ul>
        <div class="mhero__actions">
          {
            discontinued ? (
              <a href={serviceHref} class="btn btn--primary btn--lg">
                Ask us about service and parts <Icon name="arrow-right" size={18} class="icon-arrow" />
              </a>
            ) : (
              <a href={quoteHref} class="btn btn--primary btn--lg">
                Get a quote on this model <Icon name="arrow-right" size={18} class="icon-arrow" />
              </a>
            )
          }
          {
            !linkDown && (
              <a href={go} class="btn btn--ghost-light btn--lg" target="_blank" rel="noopener" data-outbound>
                <span data-outbound-text>{linkText}</span> <Icon name="arrow-up-right" size={18} />
                <span class="visually-hidden">(opens in a new tab)</span>
              </a>
            )
          }
        </div>
      </div>
      <ProductGallery
        product={p}
        name={fullName}
        brand={brand}
        outbound={discontinued || linkDown ? undefined : go}
        stores={discontinued ? [] : stores.filter((s) => s.count > 0).map((s) => ({ name: s.shortName, href: withBase(`/locations/${s.slug}/`) }))}
      />
    </div>
  </section>

  {
    discontinued && (
      <section class="notice-band" aria-labelledby="gone-title">
        <div class="container notice">
          <span class="notice__icon">
            <Icon name="info" size={22} />
          </span>
          <div class="notice__body">
            <h2 id="gone-title" class="notice__title">
              {brand} no longer makes the {p.model}
            </h2>
            <p>
              {replacement ? (
                <>
                  {brand} names the <a href={withBase(productPath(replacement))}>{replacement.model}</a> as its replacement.{' '}
                </>
              ) : p.replacement ? (
                <>{brand} names the {p.replacement.name} as its replacement. </>
              ) : (
                <>
                  {brand} hasn’t named a replacement. See the <a href={withBase(`/products/${c.slug}/#models`)}>{c.name.toLowerCase()} we carry now</a>.{' '}
                </>
              )}
              If you have one at home, we still service it and can track down parts.
            </p>
            <a href={serviceHref} class="link-arrow">
              Ask us about service and parts <Icon name="arrow-right" size={16} />
            </a>
          </div>
        </div>
      </section>
    )
  }

  <div class="container specs-gone" data-specs-notice hidden>
    <p role="status">
      <Icon name="info" size={18} />
      <span>{brand}’s page for this model isn’t available right now, so we brought you back here. Call either showroom for the full spec sheet.</span>
    </p>
  </div>

  <section class="section">
    <div class="container mgrid">
      <div class="mspecs" id="specs">
        <h2 class="mspecs__title">{discontinued ? 'What we know about it' : 'Key specs'}</h2>
        <p class="mspecs__preview" data-listing-note hidden>
          <Icon name="info" size={16} />
          <span>Preview: changes made in HMI mode and published in this browser. On the live site everyone would see them.</span>
        </p>
        <div data-listing-specs>
        {
          p.specs.length ? (
            <dl class="specs">
              {p.fuel && (
                <div>
                  <dt>Fuel</dt>
                  <dd>{fuelLabels[p.fuel]}</dd>
                </div>
              )}
              {p.specs.map((s) => (
                <div>
                  <dt>{s.label}</dt>
                  <dd>{s.value}</dd>
                </div>
              ))}
            </dl>
          ) : (
            <p class="muted">{brand} no longer publishes specs for the {p.model}. We keep service notes and parts lists for it — give us a call.</p>
          )
        }
        </div>
        <p class="mspecs__source">
          <Icon name="check" size={16} />
          <span>
            Checked against {host(p.verified.url)} on <time datetime={p.verified.on}>{checkedOn}</time>. Manufacturers update their specs, so we’ll confirm the details for
            your home before you buy.
          </span>
        </p>
        {
          linkDown ? (
            <p class="mspecs__down">
              {brand}’s page for this model isn’t available right now. Ask us for the full spec sheet.
            </p>
          ) : (
            <a href={go} class="link-arrow" target="_blank" rel="noopener" data-outbound>
              <span data-outbound-text>{linkText}</span> <Icon name="arrow-up-right" size={16} />
              <span class="visually-hidden">(opens in a new tab)</span>
            </a>
          )
        }
      </div>

      <aside class="mdisplay" aria-labelledby="display-title">
        <h2 id="display-title" class="mdisplay__title">On display at</h2>
        <ul role="list" class="mdisplay__list">
          {
            stores.map((s) => (
              <li class:list={['store-row', { 'is-on': s.count > 0 }]}>
                <span class="store-row__icon">
                  <Icon name={s.count > 0 ? 'check' : 'pin'} size={18} />
                </span>
                <span class="store-row__main">
                  <a href={withBase(`/locations/${s.slug}/`)} class="store-row__name">
                    {s.shortName}
                  </a>
                  <span class="store-row__state">
                    {s.count > 0 ? (s.count > 1 ? `${s.count} on the showroom floor` : 'On the showroom floor') : discontinued ? 'No longer on display' : 'Not on display — we can order one'}
                  </span>
                  <span class="store-row__meta">
                    {s.street}, {s.city} ·{' '}
                    <a href={tel(s.phone)} class="tabular">
                      {prettyPhone(s.phone)}
                    </a>
                  </span>
                </span>
              </li>
            ))
          }
        </ul>
        <p class="mdisplay__note">Displays change — call ahead to make sure it’s on the floor. (In this concept, display counts come from HMI mode’s sample inventory.)</p>
      </aside>
    </div>
  </section>

  <!-- More of what HMI sells here, and directly under it the brands it carries for the category -->
  <section class="section section--linen">
    <div class="container">
      <SectionHeading eyebrow={group.name} title={others.length ? `More ${c.name.toLowerCase()} we sell` : `${c.name} at HMI`} align="split">
        <a href={withBase(`/products/${c.slug}/#models`)} class="link-arrow">
          Shop all {c.name.toLowerCase()} <Icon name="arrow-right" size={16} />
        </a>
      </SectionHeading>
      {
        others.length > 0 && (
          <div class="grid grid--models">
            {others.map((o) => (
              <ProductCard product={o} />
            ))}
          </div>
        )
      }
      <BrandStrip category={c} current={p.brand} />
    </div>
  </section>

  <CtaBand
    title={discontinued ? `Need help with a <em>${esc(p.model)}?</em>` : `Interested in the <em>${esc(p.model)}?</em>`}
    text={discontinued ? 'Tell us what it’s doing and we’ll take it from there — repairs, parts and annual service.' : 'Tell us about your room and we’ll put together a clear quote, with certified installation.'}
    quoteHref={discontinued ? undefined : quoteHref}
    serviceHref={serviceHref}
  />
</BaseLayout>

<script>
  // Changes to this model published from HMI mode in this browser show as a preview
  import { initModelEdits } from '../../../../scripts/listingPreview';
  void initModelEdits();

  // Back from /go/ because the manufacturer's page failed its check: say so
  if (new URLSearchParams(location.search).get('specs') === 'unavailable') {
    const n = document.querySelector<HTMLElement>('[data-specs-notice]');
    if (n) n.hidden = false;
  }
</script>
