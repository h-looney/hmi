---
/**
 * /go/<slug>/ — every outbound manufacturer link passes through one of these pages.
 *
 * GitHub Pages can't do server redirects, so each is a tiny static page: it records the click for HMI mode
 * (src/office/bridge.ts) and replaces itself with the target; a meta refresh and a visible link cover visitors
 * without JavaScript. The target comes from the latest link check (src/data/links.ts → resolveTarget): the stored
 * URL when it works, its new address when it moved, otherwise a safe fallback — never a dead or wrong page.
 */
import { brands } from '../../data/brands';
import { linksWithTargets } from '../../data/linkHealth';
import { brandSites, productById } from '../../data/products';
import { site } from '../../data/site';
import { withBase } from '../../scripts/url';

export function getStaticPaths() {
  return linksWithTargets().map(({ link, target }) => ({ params: { slug: link.slug }, props: { link, target } }));
}

const { link, target } = Astro.props;
const product = link.productId ? productById(link.productId) : undefined;
const brandName = brandSites[link.brand]?.name ?? brands.find((b) => b.id === link.brand)?.name ?? link.label;
const internal = target.href.startsWith('/');
// A model that falls back to our own page gets a short notice there explaining why
const href = internal ? withBase(target.mode === 'fallback' && link.kind === 'model' ? `${target.href}?specs=unavailable` : target.href) : target.href;
const host = internal ? '' : new URL(target.href).hostname.replace(/^www\./, '');

const fallback = target.mode === 'fallback';
const what = link.kind === 'model' ? `${brandName}’s page for the ${product?.model ?? link.label}` : link.kind === 'support' ? `${brandName}’s owner support` : link.kind === 'tool' ? link.label : `${brandName}’s website`;
const destination = !internal
  ? host
  : link.kind === 'model'
    ? `our ${product?.model ?? ''} page`.replace(/\s+page$/, ' page')
    : target.href.startsWith('/resources')
      ? 'our owner resources'
      : 'our brand directory';
const heading = fallback ? `${what[0].toUpperCase()}${what.slice(1)} isn’t available right now` : `Taking you to ${what}`;
const explain = fallback
  ? link.kind === 'model'
    ? `We check every manufacturer link each night. This one isn’t working at the moment, so we’re taking you to our own page for the ${product?.model}, with the specs we’ve verified.`
    : `We check every manufacturer link each night. This one isn’t working at the moment, so we’re sending you somewhere that is.`
  : `You’re leaving ${site.name} for ${host}.`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta http-equiv="refresh" content={`1; url=${href}`} />
    <title>{fallback ? heading : `Continue to ${host || destination}`} | {site.name}</title>
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <style is:inline>
      :root {
        color-scheme: light;
      }
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 1.5rem;
        background: #efe7db;
        color: #2b2420;
        font: 16px/1.55 system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
      }
      .go {
        box-sizing: border-box;
        width: min(100%, 34rem);
        padding: 2rem 1.75rem;
        background: #fffcf7;
        border: 1px solid #ddd0bf;
        border-radius: 14px;
        box-shadow: 0 18px 40px -24px rgb(27 23 20 / 0.45);
      }
      .go__brand {
        margin: 0 0 1.25rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        color: #ad4118;
      }
      .go__brand a {
        color: inherit;
        text-decoration: none;
      }
      h1 {
        margin: 0 0 0.6rem;
        font-size: 1.35rem;
        line-height: 1.3;
      }
      p {
        margin: 0 0 1rem;
      }
      .go__continue {
        display: inline-block;
        margin-top: 0.25rem;
        padding: 0.7rem 1.1rem;
        border-radius: 8px;
        background: #ad4118;
        color: #fff;
        font-weight: 600;
        text-decoration: none;
        overflow-wrap: anywhere;
      }
      .go__continue:hover {
        background: #933712;
      }
      .go__continue:focus-visible,
      a:focus-visible {
        outline: 3px solid #1b1714;
        outline-offset: 3px;
      }
      .go__muted {
        margin: 1.25rem 0 0;
        font-size: 0.9rem;
        color: #6a5d52;
      }
      .go__muted a {
        color: #7a2d0f;
      }
    </style>
  </head>
  <body>
    <main
      class="go"
      data-go
      data-slug={link.slug}
      data-kind={link.kind}
      data-brand={link.brand}
      data-product={link.productId ?? ''}
      data-label={link.label}
      data-mode={target.mode}
      data-to={href}
    >
      <p class="go__brand"><a href={withBase('/')}>{site.name}</a></p>
      <h1>{heading}</h1>
      <p>{explain}</p>
      <p><a class="go__continue" href={href} rel={internal ? undefined : 'noopener'}>Continue to {destination} <span aria-hidden="true">→</span></a></p>
      <p class="go__muted">
        {
          link.kind === 'model' && product && !(fallback && internal) ? (
            <>
              Questions about the {product.model}? <a href={withBase(`/contact/?model=${product.id}`)}>Ask HMI for a quote</a> or call either showroom.
            </>
          ) : (
            <a href={withBase('/')}>Back to {site.name}</a>
          )
        }
      </p>
    </main>
    <script>
      import { recordClick, type GoClick } from '../../office/bridge';

      const el = document.querySelector<HTMLElement>('[data-go]');
      if (el) {
        const d = el.dataset;
        let from: string | undefined;
        try {
          const ref = document.referrer ? new URL(document.referrer) : null;
          if (ref && ref.origin === location.origin) from = ref.pathname;
        } catch {
          /* no referrer */
        }
        recordClick({
          slug: d.slug!,
          kind: d.kind as GoClick['kind'],
          brand: d.brand!,
          productId: d.product || undefined,
          label: d.label!,
          mode: d.mode as GoClick['mode'],
          to: d.to!,
          from,
        });
        location.replace(d.to!);
      }
    </script>
  </body>
</html>
