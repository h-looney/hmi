---
/**
 * Click-to-load video facade for YouTube and Vimeo. Shows a poster and a play
 * button; the heavy player iframe is only created when the visitor clicks.
 */
import type { ImageMetadata } from 'astro';
import Photo from './Photo.astro';
import Icon from './Icon.astro';
import type { Video } from '../data/videos';

interface Props {
  video: Video;
  poster?: ImageMetadata;
  posterPosition?: string;
  class?: string;
}

const { video, poster, posterPosition, class: className } = Astro.props;

const embed =
  video.provider === 'youtube'
    ? `https://www.youtube-nocookie.com/embed/${video.id}?autoplay=1&rel=0`
    : `https://player.vimeo.com/video/${video.id}?autoplay=1&badge=0&byline=0&portrait=0&title=0&dnt=1`;

const ytPoster = video.provider === 'youtube' ? `https://i.ytimg.com/vi/${video.id}/hqdefault.jpg` : undefined;

const duration = video.duration
  ? `${Math.floor(video.duration / 60)}:${String(video.duration % 60).padStart(2, '0')}`
  : undefined;
---

<div class:list={['lite-video', className]} data-lite-video data-embed={embed} data-title={video.title}>
  {
    poster ? (
      <Photo src={poster} alt="" sizes="(min-width: 960px) 640px, 100vw" position={posterPosition} class="lite-video__poster" />
    ) : ytPoster ? (
      <img src={ytPoster} alt="" class="lite-video__poster" loading="lazy" decoding="async" width="480" height="360" />
    ) : (
      <div class="lite-video__poster lite-video__poster--brand" aria-hidden="true">
        <Icon name="flame" size={64} strokeWidth={1.2} />
      </div>
    )
  }
  <button type="button" class="lite-video__play">
    <span class="lite-video__icon"><Icon name="play" size={26} /></span>
    <span class="lite-video__meta">
      <span class="lite-video__title">{video.title}</span>
      {duration && <span class="lite-video__duration">{duration}</span>}
    </span>
    <span class="visually-hidden">Play video</span>
  </button>
</div>

<style>
  .lite-video {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--c-ink-2);
    isolation: isolate;
  }

  .lite-video :global(.lite-video__poster),
  .lite-video :global(.lite-video__poster img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .lite-video__poster--brand {
    display: grid;
    place-items: center;
    color: rgb(240 160 75 / 0.55);
    background:
      radial-gradient(circle at 50% 70%, rgb(185 71 27 / 0.45), transparent 60%),
      linear-gradient(160deg, var(--c-ink-3), var(--c-ink));
  }

  .lite-video::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgb(20 17 15 / 0.75), rgb(20 17 15 / 0.05) 60%);
    pointer-events: none;
  }

  .lite-video :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    z-index: 2;
  }

  .lite-video__play {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    align-items: flex-end;
    gap: var(--space-4);
    padding: var(--space-5);
    width: 100%;
    color: #fff;
    text-align: left;
  }

  .lite-video__icon {
    display: grid;
    place-items: center;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: var(--c-ember);
    box-shadow: 0 0 0 8px rgb(185 71 27 / 0.25);
    flex: none;
    transition:
      transform var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease);
  }

  .lite-video__icon :global(svg) {
    translate: 2px 0;
  }

  .lite-video__play:hover .lite-video__icon {
    transform: scale(1.06);
    box-shadow: 0 0 0 12px rgb(185 71 27 / 0.22);
  }

  .lite-video__meta {
    display: grid;
    gap: 0.1rem;
    padding-bottom: 0.35rem;
  }

  .lite-video__title {
    font-family: var(--font-display);
    font-size: var(--fs-md);
    line-height: 1.25;
    text-shadow: 0 1px 8px rgb(0 0 0 / 0.5);
  }

  .lite-video__duration {
    font-size: var(--fs-xs);
    color: rgb(255 255 255 / 0.8);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-lite-video]').forEach((wrap) => {
    wrap.querySelector('button')?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = wrap.dataset.embed ?? '';
      iframe.title = wrap.dataset.title ?? 'Video';
      iframe.allow = 'autoplay; fullscreen; picture-in-picture; encrypted-media';
      iframe.allowFullscreen = true;
      wrap.append(iframe);
      wrap.querySelector('button')?.remove();
      iframe.focus();
    });
  });
</script>
