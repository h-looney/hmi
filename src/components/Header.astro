---
import { Image } from 'astro:assets';
import logoLight from '../assets/brand/logo-light.png';
import logoDark from '../assets/brand/logo-dark.png';
import stoveWood from '../assets/photos/stove-wood-cast-iron.png';
import Icon from './Icon.astro';
import OpenStatus from './OpenStatus.astro';
import { mainNav, productColumns } from '../data/navigation';
import { locations, site, tel, prettyPhone } from '../data/site';
import { withBase } from '../scripts/url';

const path = Astro.url.pathname;
const isCurrent = (href: string) => {
  const clean = href.split('#')[0];
  return clean !== withBase('/') && path.startsWith(clean);
};

const socials = [
  { name: 'facebook', href: site.social.facebook, label: 'HMI on Facebook' },
  { name: 'youtube', href: site.social.youtube, label: 'HMI on YouTube' },
  { name: 'houzz', href: site.social.houzz, label: 'HMI on Houzz' },
  { name: 'x', href: site.social.x, label: 'HMI on X' },
] as const;
---

<aside class="topbar no-print" aria-label="Showroom phone numbers">
  <div class="container topbar__inner">
    <p class="topbar__note">
      <Icon name="flame" size={14} />
      Family-owned since {site.founded} · Lake of the Ozarks &amp; Southwest Missouri
    </p>
    <ul class="topbar__stores" role="list">
      {
        locations.map((l) => (
          <li class="topbar__store">
            <a href={tel(l.phone)} class="topbar__phone">
              <Icon name="phone" size={14} />
              <span class="topbar__store-name">{l.shortName}</span>
              <span class="tabular">{prettyPhone(l.phone)}</span>
            </a>
            <OpenStatus location={l} detail={false} class="topbar__status" />
          </li>
        ))
      }
    </ul>
    <ul class="topbar__social" role="list">
      {
        socials.map((s) => (
          <li>
            <a href={s.href} target="_blank" rel="noopener" aria-label={s.label}>
              <Icon name={s.name} size={16} />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</aside>

<header class="site-header" data-header>
  <div class="container navbar">
    <a href={withBase('/')} class="navbar__logo" aria-label="HMI Fireplace Shops — home">
      <Image src={logoLight} alt="" width={226} densities={[1, 2]} loading="eager" fetchpriority="high" />
    </a>

    <nav class="primary-nav" aria-label="Main">
      <ul class="primary-nav__list" role="list">
        {
          mainNav.map((item, i) => {
            const panelId = `nav-panel-${i}`;
            const hasPanel = item.mega || item.children;
            return (
              <li class:list={['primary-nav__item', { 'has-dropdown': item.children }]} data-nav-item>
                {hasPanel ? (
                  <button
                    class="primary-nav__link"
                    aria-expanded="false"
                    aria-controls={panelId}
                    data-nav-trigger
                    data-current={isCurrent(item.href) ? 'true' : undefined}
                  >
                    {item.label}
                    <Icon name="chevron-down" size={15} class="primary-nav__chev" />
                  </button>
                ) : (
                  <a class="primary-nav__link" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                    {item.label}
                  </a>
                )}

                {item.mega && (
                  <div class="nav-panel mega" id={panelId} data-nav-panel>
                    <div class="container mega__inner">
                      <div class="mega__cols">
                        {productColumns.map((col) => (
                          <div class="mega__col">
                            <p class="mega__heading">{col.name}</p>
                            <p class="mega__blurb">{col.blurb}</p>
                            <ul role="list" class="mega__links">
                              {col.links.map((link) => (
                                <li>
                                  <a href={link.href} aria-current={path === link.href ? 'page' : undefined}>
                                    {link.label}
                                  </a>
                                </li>
                              ))}
                            </ul>
                          </div>
                        ))}
                      </div>
                      <a class="mega__feature" href={withBase('/#featured')}>
                        <span class="mega__feature-media">
                          <Image src={stoveWood} alt="" width={200} densities={[1, 2]} />
                        </span>
                        <span class="eyebrow eyebrow--plain">Fall feature</span>
                        <span class="mega__feature-title">Vermont Castings stoves by Forge &amp; Flame</span>
                        <span class="link-arrow">
                          See the collection <Icon name="arrow-right" size={16} />
                        </span>
                      </a>
                    </div>
                    <div class="mega__footer">
                      <div class="container mega__footer-inner">
                        <a href={withBase('/products/')} class="link-arrow">
                          View all products <Icon name="arrow-right" size={16} />
                        </a>
                        <a href={withBase('/fireplace-finder/')} class="link-arrow">
                          Not sure where to start? Take the Fireplace Finder <Icon name="arrow-right" size={16} />
                        </a>
                        <a href={withBase('/products/#brands')} class="link-arrow">
                          Brands we carry <Icon name="arrow-right" size={16} />
                        </a>
                      </div>
                    </div>
                  </div>
                )}

                {item.children && (
                  <div class="nav-panel dropdown" id={panelId} data-nav-panel>
                    <ul role="list">
                      {item.children.map((child) => (
                        <li>
                          <a href={child.href} class="dropdown__link">
                            <span class="dropdown__label">{child.label}</span>
                            {child.description && <span class="dropdown__desc">{child.description}</span>}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </li>
            );
          })
        }
      </ul>
    </nav>

    <div class="navbar__actions">
      <a href={withBase('/contact/')} class="btn btn--primary btn--sm navbar__cta">Request a quote</a>
      <button class="navbar__menu" type="button" data-drawer-open aria-haspopup="dialog" aria-controls="site-drawer">
        <Icon name="menu" size={24} />
        <span class="visually-hidden">Open menu</span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile navigation drawer -->
<dialog class="drawer" id="site-drawer" data-drawer aria-label="Site menu">
  <div class="drawer__inner">
    <div class="drawer__head">
      <a href={withBase('/')} aria-label="HMI Fireplace Shops — home" class="drawer__logo">
        <Image src={logoDark} alt="" width={190} densities={[1, 2]} />
      </a>
      <button type="button" class="drawer__close" data-drawer-close>
        <Icon name="close" size={24} />
        <span class="visually-hidden">Close menu</span>
      </button>
    </div>

    <nav class="drawer__nav" aria-label="Mobile">
      <details class="drawer__group">
        <summary>Products <Icon name="chevron-down" size={18} /></summary>
        <div class="drawer__panel">
          {
            productColumns.map((col) => (
              <div class="drawer__sub">
                <p class="drawer__subhead">{col.name}</p>
                <ul role="list">
                  {col.links.map((link) => (
                    <li>
                      <a href={link.href}>{link.label}</a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
          <a href={withBase('/products/')} class="link-arrow">View all products <Icon name="arrow-right" size={16} /></a>
        </div>
      </details>
      <a class="drawer__link" href={withBase('/fireplace-finder/')}>Fireplace Finder</a>
      {
        mainNav
          .filter((item) => item.children)
          .map((item) => (
            <details class="drawer__group">
              <summary>
                {item.label} <Icon name="chevron-down" size={18} />
              </summary>
              <div class="drawer__panel">
                <ul role="list">
                  {item.children!.map((child) => (
                    <li>
                      <a href={child.href}>{child.label}</a>
                    </li>
                  ))}
                </ul>
              </div>
            </details>
          ))
      }
      <a class="drawer__link" href={withBase('/gallery/')}>Inspiration gallery</a>
    </nav>

    <div class="drawer__footer">
      <a href={withBase('/contact/')} class="btn btn--primary btn--block btn--lg">Request a quote</a>
      <ul role="list" class="drawer__stores">
        {
          locations.map((l) => (
            <li>
              <a href={tel(l.phone)} class="drawer__store">
                <span class="icon-tile">
                  <Icon name="phone" size={20} />
                </span>
                <span>
                  <strong>Call {l.shortName}</strong>
                  <span class="tabular">{prettyPhone(l.phone)}</span>
                </span>
              </a>
              <OpenStatus location={l} />
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</dialog>

<style>
  /* ---------- Top bar ---------- */
  .topbar {
    background: #14110f;
    color: var(--c-text-invert-muted);
    font-size: var(--fs-xs);
  }

  .topbar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    min-height: 40px;
  }

  .topbar__note {
    display: flex;
    align-items: center;
    gap: 0.5em;
    color: var(--c-text-invert-muted);
  }

  .topbar__note :global(svg) {
    color: var(--c-flame);
  }

  .topbar__stores {
    display: flex;
    gap: var(--space-5);
    margin-left: auto;
    padding: 0;
    list-style: none;
  }

  .topbar__store {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .topbar__phone {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    color: var(--c-text-invert);
    text-decoration: none;
    font-weight: 500;
  }

  .topbar__phone:hover {
    color: var(--c-flame);
  }

  .topbar__store-name {
    color: var(--c-text-invert-muted);
    font-weight: 400;
  }

  .topbar__store :global(.topbar__status) {
    color: var(--c-text-invert-muted);
    font-weight: 500;
  }

  .topbar__social {
    display: flex;
    gap: var(--space-1);
    padding: 0;
    list-style: none;
    --icon-cutout: #14110f;
  }

  .topbar__social a {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    color: var(--c-text-invert-muted);
    transition: color var(--dur) var(--ease), background-color var(--dur) var(--ease);
  }

  .topbar__social a:hover {
    color: var(--c-text-invert);
    background: rgb(255 255 255 / 0.08);
  }

  @media (max-width: 1100px) {
    .topbar__note {
      display: none;
    }
  }

  @media (max-width: 760px) {
    .topbar {
      display: none;
    }
  }

  /* ---------- Header ---------- */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--c-ink);
    color: var(--c-text-invert);
    border-bottom: 1px solid var(--c-ink-line);
    transition: box-shadow var(--dur) var(--ease), background-color var(--dur) var(--ease);
  }

  .site-header.is-scrolled {
    box-shadow: 0 10px 30px -12px rgb(0 0 0 / 0.55);
  }

  @supports (backdrop-filter: blur(8px)) {
    .site-header.is-scrolled {
      background: rgb(27 23 20 / 0.92);
      backdrop-filter: saturate(1.4) blur(12px);
    }
  }

  .navbar {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    height: var(--header-h);
  }

  .navbar__logo {
    flex: none;
    display: block;
    padding-block: var(--space-2);
  }

  .navbar__logo :global(img) {
    width: clamp(170px, 14vw + 60px, 226px);
    height: auto;
  }

  .primary-nav {
    margin-left: auto;
    height: 100%;
  }

  .primary-nav__list {
    display: flex;
    align-items: stretch;
    height: 100%;
    gap: 0.1rem;
    padding: 0;
    list-style: none;
  }

  .primary-nav__item {
    display: flex;
    align-items: stretch;
  }

  .primary-nav__item.has-dropdown {
    position: relative;
  }

  .primary-nav__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    padding: 0 0.85rem;
    color: var(--c-text-invert);
    font-size: var(--fs-sm);
    font-weight: 550;
    letter-spacing: 0.005em;
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--dur) var(--ease);
  }

  .primary-nav__link::after {
    content: '';
    position: absolute;
    left: 0.85rem;
    right: 0.85rem;
    bottom: 0;
    height: 2px;
    background: var(--c-flame);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 260ms var(--ease-out);
  }

  .primary-nav__link:hover,
  .primary-nav__item.is-open > .primary-nav__link {
    color: #fff;
  }

  .primary-nav__link:hover::after,
  .primary-nav__item.is-open > .primary-nav__link::after,
  .primary-nav__link[aria-current='page']::after,
  .primary-nav__link[data-current]::after {
    transform: scaleX(1);
  }

  .primary-nav__link :global(.primary-nav__chev) {
    opacity: 0.7;
    transition: transform var(--dur) var(--ease);
  }

  .primary-nav__item.is-open :global(.primary-nav__chev) {
    transform: rotate(180deg);
  }

  .navbar__actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .navbar__menu {
    display: none;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: var(--radius);
    color: var(--c-text-invert);
    border: 1px solid var(--c-ink-line);
  }

  .navbar__menu:hover {
    background: var(--c-ink-3);
  }

  @media (max-width: 1180px) {
    .primary-nav__link {
      padding-inline: 0.6rem;
    }

    .primary-nav__link::after {
      left: 0.6rem;
      right: 0.6rem;
    }
  }

  @media (max-width: 1060px) {
    .primary-nav {
      display: none;
    }

    .navbar__menu {
      display: grid;
    }

    .navbar__actions {
      margin-left: auto;
    }
  }

  @media (max-width: 480px) {
    .navbar__cta {
      display: none;
    }
  }

  /* ---------- Panels (mega + dropdown) ---------- */
  .nav-panel {
    position: absolute;
    top: 100%;
    z-index: 10;
    color: var(--c-text);
    opacity: 0;
    visibility: hidden;
    translate: 0 -6px;
    transition:
      opacity 180ms var(--ease),
      translate 180ms var(--ease),
      visibility 0s linear 180ms;
  }

  .primary-nav__item.is-open > .nav-panel,
  :global(html:not(.js)) .primary-nav__item:hover > .nav-panel,
  :global(html:not(.js)) .primary-nav__item:focus-within > .nav-panel {
    opacity: 1;
    visibility: visible;
    translate: 0 0;
    transition:
      opacity 180ms var(--ease),
      translate 180ms var(--ease),
      visibility 0s;
  }

  .mega {
    left: 0;
    right: 0;
    background: var(--c-paper);
    border-bottom: 1px solid var(--c-stone);
    box-shadow: 0 30px 60px -20px rgb(27 23 20 / 0.4);
  }

  .mega__inner {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: var(--space-7);
    padding-block: var(--space-6) var(--space-6);
  }

  .mega__cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  .mega__heading {
    font-family: var(--font-display);
    font-size: var(--fs-md);
    font-weight: 500;
  }

  .mega__blurb {
    margin-top: 0.25rem;
    font-size: var(--fs-xs);
    color: var(--c-text-muted);
    line-height: 1.5;
  }

  .mega__links {
    display: grid;
    gap: 0.1rem;
    margin-top: var(--space-3);
    padding: var(--space-3) 0 0;
    border-top: 1px solid var(--c-stone);
    list-style: none;
  }

  .mega__links a {
    display: block;
    padding: 0.38rem 0;
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--c-text);
    text-decoration: none;
    transition: color var(--dur) var(--ease), translate var(--dur) var(--ease);
  }

  .mega__links a:hover,
  .mega__links a[aria-current='page'] {
    color: var(--c-ember);
    translate: 3px 0;
  }

  .mega__feature {
    display: grid;
    align-content: start;
    gap: var(--space-2);
    padding: var(--space-5);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(circle at 50% 35%, rgb(240 160 75 / 0.18), transparent 60%),
      var(--c-linen);
    color: var(--c-text);
    text-decoration: none;
    transition: background-color var(--dur) var(--ease);
  }

  .mega__feature:hover .mega__feature-title {
    color: var(--c-ember);
  }

  .mega__feature-media {
    display: grid;
    place-items: center;
    margin-bottom: var(--space-2);
  }

  .mega__feature-media :global(img) {
    width: 160px;
    height: auto;
    filter: drop-shadow(0 14px 18px rgb(27 23 20 / 0.25));
  }

  .mega__feature-title {
    font-family: var(--font-display);
    font-size: var(--fs-md);
    line-height: 1.3;
    transition: color var(--dur) var(--ease);
  }

  .mega__footer {
    background: var(--c-linen);
    border-top: 1px solid var(--c-stone);
  }

  .mega__footer-inner {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-7);
    padding-block: var(--space-4);
  }

  .dropdown {
    left: 50%;
    min-width: 300px;
    margin-left: -150px;
    padding: var(--space-2);
    background: var(--c-paper);
    border: 1px solid var(--c-stone);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
  }

  .dropdown ul {
    padding: 0;
    list-style: none;
  }

  .dropdown__link {
    display: grid;
    gap: 2px;
    padding: 0.7rem 0.9rem;
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--c-text);
    transition: background-color var(--dur) var(--ease);
  }

  .dropdown__link:hover {
    background: var(--c-linen);
  }

  .dropdown__label {
    font-weight: 600;
    font-size: var(--fs-sm);
  }

  .dropdown__link:hover .dropdown__label {
    color: var(--c-ember);
  }

  .dropdown__desc {
    font-size: var(--fs-xs);
    color: var(--c-text-muted);
  }

  /* ---------- Drawer ---------- */
  .drawer {
    margin: 0 0 0 auto;
    width: min(420px, 100%);
    max-width: 100%;
    height: 100dvh;
    max-height: 100dvh;
    padding: 0;
    border: 0;
    background: var(--c-paper);
    color: var(--c-text);
    box-shadow: var(--shadow-lg);
    overscroll-behavior: contain;
  }

  .drawer::backdrop {
    background: rgb(20 17 15 / 0.55);
    backdrop-filter: blur(2px);
  }

  @media (prefers-reduced-motion: no-preference) {
    .drawer[open] {
      animation: drawer-in 320ms var(--ease-out);
    }

    .drawer[open]::backdrop {
      animation: fade-in 320ms var(--ease-out);
    }
  }

  @keyframes drawer-in {
    from {
      translate: 100% 0;
    }
  }

  @keyframes fade-in {
    from {
      opacity: 0;
    }
  }

  .drawer__inner {
    display: flex;
    flex-direction: column;
    min-height: 100%;
  }

  .drawer__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    border-bottom: 1px solid var(--c-stone);
  }

  .drawer__close {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius);
    border: 1px solid var(--c-stone);
  }

  .drawer__nav {
    display: grid;
    padding: var(--space-2) var(--space-5);
  }

  .drawer__link,
  .drawer__group summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 0;
    border-bottom: 1px solid var(--c-stone);
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--c-text);
    text-decoration: none;
    cursor: pointer;
    list-style: none;
  }

  .drawer__group summary::-webkit-details-marker {
    display: none;
  }

  .drawer__group summary :global(svg) {
    transition: transform var(--dur) var(--ease);
  }

  .drawer__group[open] summary :global(svg) {
    transform: rotate(180deg);
  }

  .drawer__panel {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-4) 0 var(--space-5);
    border-bottom: 1px solid var(--c-stone);
  }

  .drawer__panel ul {
    display: grid;
    gap: 0.15rem;
    padding: 0;
    list-style: none;
  }

  .drawer__panel ul a {
    display: block;
    padding: 0.4rem 0;
    color: var(--c-text);
    text-decoration: none;
    font-weight: 500;
  }

  .drawer__subhead {
    font-size: var(--fs-2xs);
    font-weight: 650;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-ember);
    margin-bottom: var(--space-1);
  }

  .drawer__footer {
    display: grid;
    gap: var(--space-4);
    margin-top: auto;
    padding: var(--space-5);
    background: var(--c-linen);
  }

  .drawer__stores {
    display: grid;
    gap: var(--space-3);
    padding: 0;
    list-style: none;
  }

  .drawer__stores li {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    background: var(--c-paper);
    border: 1px solid var(--c-stone);
    border-radius: var(--radius);
  }

  .drawer__store {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    color: var(--c-text);
  }

  .drawer__store > span:last-child {
    display: grid;
    line-height: 1.35;
  }

  .drawer__store .icon-tile {
    width: 42px;
    height: 42px;
    border-radius: 10px;
  }
</style>

<script>
  /* ----- Desktop dropdowns & mega menu (disclosure pattern) ----- */
  const items = Array.from(document.querySelectorAll<HTMLElement>('[data-nav-item]')).filter((item) =>
    item.querySelector('[data-nav-trigger]'),
  );
  const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
  const timers = new WeakMap<HTMLElement, number>();

  const setOpen = (item: HTMLElement, open: boolean) => {
    item.classList.toggle('is-open', open);
    item.querySelector('[data-nav-trigger]')?.setAttribute('aria-expanded', String(open));
  };

  const closeAll = (except?: HTMLElement) => items.forEach((i) => i !== except && setOpen(i, false));

  items.forEach((item) => {
    const trigger = item.querySelector<HTMLButtonElement>('[data-nav-trigger]')!;

    trigger.addEventListener('click', () => {
      const open = !item.classList.contains('is-open');
      closeAll(item);
      setOpen(item, open);
    });

    item.addEventListener('mouseenter', () => {
      if (!finePointer.matches) return;
      window.clearTimeout(timers.get(item));
      timers.set(
        item,
        window.setTimeout(() => {
          closeAll(item);
          setOpen(item, true);
        }, 90),
      );
    });

    item.addEventListener('mouseleave', () => {
      if (!finePointer.matches) return;
      window.clearTimeout(timers.get(item));
      timers.set(item, window.setTimeout(() => setOpen(item, false), 220));
    });

    item.addEventListener('focusout', (e) => {
      const next = (e as FocusEvent).relatedTarget as Node | null;
      if (next && !item.contains(next)) setOpen(item, false);
    });

    item.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && item.classList.contains('is-open')) {
        setOpen(item, false);
        trigger.focus();
      }
    });
  });

  document.addEventListener('click', (e) => {
    const target = e.target as Node;
    if (!items.some((i) => i.contains(target))) closeAll();
  });

  /* ----- Header elevation on scroll ----- */
  const header = document.querySelector<HTMLElement>('[data-header]');
  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  /* ----- Mobile drawer ----- */
  const drawer = document.querySelector<HTMLDialogElement>('[data-drawer]');
  const opener = document.querySelector<HTMLButtonElement>('[data-drawer-open]');

  opener?.addEventListener('click', () => {
    drawer?.showModal();
    opener.setAttribute('aria-expanded', 'true');
  });

  drawer?.addEventListener('close', () => opener?.setAttribute('aria-expanded', 'false'));
  drawer?.querySelector('[data-drawer-close]')?.addEventListener('click', () => drawer.close());

  // Close when clicking the backdrop (the dialog element itself).
  drawer?.addEventListener('click', (e) => {
    if (e.target === drawer) drawer.close();
  });

  // Close after following an in-page link.
  drawer?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => drawer.close()));

  // Drawer is mobile-only; close it if the viewport grows past the breakpoint.
  window.matchMedia('(min-width: 1061px)').addEventListener('change', (e) => {
    if (e.matches && drawer?.open) drawer.close();
  });
</script>
