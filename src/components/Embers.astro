---
/**
 * Subtle rising embers drawn on a canvas. Decorative only: hidden from
 * assistive tech, paused when off-screen or in a background tab, and
 * disabled entirely for visitors who prefer reduced motion.
 */
interface Props {
  class?: string;
  density?: number;
}

const { class: className, density = 1 } = Astro.props;
---

<canvas class:list={['embers', className]} data-embers data-density={density} aria-hidden="true"></canvas>

<style>
  .embers {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
  }
</style>

<script>
  type Ember = { x: number; y: number; r: number; vy: number; vx: number; life: number; max: number; phase: number; hue: number };

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLCanvasElement>('[data-embers]').forEach((canvas) => {
    if (reduceMotion.matches) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const density = Number(canvas.dataset.density ?? 1);
    let width = 0;
    let height = 0;
    let embers: Ember[] = [];
    let raf = 0;
    let running = false;
    let last = performance.now();

    const spawn = (initial = false): Ember => {
      const max = 6 + Math.random() * 8;
      return {
        x: Math.random() * width,
        y: initial ? Math.random() * height : height + 10,
        r: 0.6 + Math.random() * 1.8,
        vy: 14 + Math.random() * 30,
        vx: -4 + Math.random() * 8,
        life: initial ? Math.random() * max : 0,
        max,
        phase: Math.random() * Math.PI * 2,
        hue: 18 + Math.random() * 22,
      };
    };

    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = canvas.clientWidth;
      height = canvas.clientHeight;
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const count = Math.min(80, Math.round(((width * height) / 16000) * density));
      embers = Array.from({ length: count }, () => spawn(true));
    };

    const frame = (now: number) => {
      const dt = Math.min((now - last) / 1000, 0.05);
      last = now;
      ctx.clearRect(0, 0, width, height);
      ctx.globalCompositeOperation = 'lighter';

      for (let i = 0; i < embers.length; i++) {
        const e = embers[i];
        e.life += dt;
        e.y -= e.vy * dt;
        e.x += (e.vx + Math.sin(e.life * 1.6 + e.phase) * 9) * dt;
        if (e.life > e.max || e.y < -10) {
          embers[i] = spawn();
          continue;
        }
        const t = e.life / e.max;
        const alpha = Math.sin(Math.PI * t) * 0.85;
        const flicker = 0.75 + Math.sin(e.life * 12 + e.phase) * 0.25;
        const glow = ctx.createRadialGradient(e.x, e.y, 0, e.x, e.y, e.r * 4);
        glow.addColorStop(0, `hsla(${e.hue + 15}, 100%, 72%, ${alpha * flicker})`);
        glow.addColorStop(0.35, `hsla(${e.hue}, 95%, 55%, ${alpha * 0.45 * flicker})`);
        glow.addColorStop(1, `hsla(${e.hue}, 90%, 45%, 0)`);
        ctx.fillStyle = glow;
        ctx.beginPath();
        ctx.arc(e.x, e.y, e.r * 4, 0, Math.PI * 2);
        ctx.fill();
      }

      ctx.globalCompositeOperation = 'source-over';
      raf = requestAnimationFrame(frame);
    };

    const start = () => {
      if (running) return;
      running = true;
      last = performance.now();
      raf = requestAnimationFrame(frame);
    };

    const stop = () => {
      running = false;
      cancelAnimationFrame(raf);
    };

    resize();
    new ResizeObserver(resize).observe(canvas);

    let visible = false;
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      visible && !document.hidden ? start() : stop();
    }).observe(canvas);

    document.addEventListener('visibilitychange', () => (document.hidden || !visible ? stop() : start()));
    reduceMotion.addEventListener('change', (e) => {
      if (e.matches) {
        stop();
        ctx.clearRect(0, 0, width, height);
      }
    });
  });
</script>
