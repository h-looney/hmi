---
import { Image } from 'astro:assets';
import logoLight from '../assets/brand/logo-light.png';
import Icon from './Icon.astro';
import OpenStatus from './OpenStatus.astro';
import { footerNav } from '../data/navigation';
import { locations, site, tel, prettyPhone } from '../data/site';
import { withBase } from '../scripts/url';

const year = new Date().getFullYear();

const socials = [
  { name: 'facebook', href: site.social.facebook, label: 'Facebook' },
  { name: 'youtube', href: site.social.youtube, label: 'YouTube' },
  { name: 'houzz', href: site.social.houzz, label: 'Houzz' },
  { name: 'x', href: site.social.x, label: 'X (Twitter)' },
] as const;
---

<footer class="site-footer on-dark">
  <div class="container footer__grid">
    <div class="footer__brand">
      <a href={withBase('/')} aria-label="HMI Fireplace Shops — home" class="footer__logo">
        <Image src={logoLight} alt="" width={220} densities={[1, 2]} />
      </a>
      <p class="footer__motto">{site.motto}</p>
      <p class="footer__blurb">
        Family-owned and operated since {site.founded}. Fireplaces, inserts, stoves and stone — sold, installed and
        serviced by our own certified team.
      </p>
      <ul class="footer__social" role="list">
        {
          socials.map((s) => (
            <li>
              <a href={s.href} target="_blank" rel="noopener">
                <Icon name={s.name} size={18} />
                <span class="visually-hidden">HMI on {s.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    {
      footerNav.map((col) => (
        <nav class="footer__col" aria-label={col.title}>
          <p class="footer__heading">{col.title}</p>
          <ul role="list">
            {col.links.map((l) => (
              <li>
                <a href={l.href}>{l.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }

    <div class="footer__col footer__visit">
      <p class="footer__heading">Visit us</p>
      {
        locations.map((l) => (
          <address class="footer__store">
            <a href={withBase(`/locations/${l.slug}/`)} class="footer__store-name">
              {l.shortName}, MO
            </a>
            <span>{l.street}</span>
            <span>
              {l.city}, {l.state} {l.zip}
            </span>
            <a href={tel(l.phone)} class="footer__phone tabular">
              <Icon name="phone" size={14} /> {prettyPhone(l.phone)}
            </a>
            <OpenStatus location={l} />
          </address>
        ))
      }
    </div>
  </div>

  <div class="container footer__hours">
    <Icon name="clock" size={18} />
    <dl>
      {
        site.hoursSummary.map((h) => (
          <div>
            <dt>{h.days}</dt>
            <dd>{h.time}</dd>
          </div>
        ))
      }
    </dl>
  </div>

  <div class="footer__bottom">
    <div class="container footer__bottom-inner">
      <p>© {year} {site.legalName}. All rights reserved.</p>
      <p class="footer__bottom-links">
        <a href={withBase('/careers/')}>Careers</a>
        <a href={withBase('/resources/')}>Owner resources</a>
        <a href={withBase('/contact/')}>Contact</a>
        <a href={withBase('/office/')}>Staff sign-in</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    background:
      radial-gradient(ellipse 60% 120% at 85% 0%, rgb(185 71 27 / 0.12), transparent 60%),
      var(--c-ink);
    padding-top: var(--space-9);
    --icon-cutout: var(--c-ink);
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 1.5fr repeat(3, 1fr) 1.25fr;
    gap: var(--space-7) var(--space-6);
  }

  .footer__logo :global(img) {
    width: 210px;
    height: auto;
  }

  .footer__motto {
    margin-top: var(--space-5);
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--fs-md);
    color: var(--c-flame);
  }

  .footer__blurb {
    margin-top: var(--space-3);
    max-width: 34ch;
    font-size: var(--fs-sm);
    color: var(--c-text-invert-muted);
  }

  .footer__social {
    display: flex;
    gap: var(--space-2);
    margin-top: var(--space-5);
    padding: 0;
    list-style: none;
  }

  .footer__social a {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--c-ink-line);
    color: var(--c-text-invert);
    transition: background-color var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }

  .footer__social a:hover {
    background: var(--c-ember);
    border-color: var(--c-ember);
    --icon-cutout: var(--c-ember);
  }

  .footer__heading {
    margin-bottom: var(--space-4);
    font-size: var(--fs-2xs);
    font-weight: 650;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--c-brass-light);
  }

  .footer__col ul {
    display: grid;
    gap: 0.55rem;
    padding: 0;
    list-style: none;
  }

  .footer__col a {
    color: var(--c-text-invert-muted);
    text-decoration: none;
    font-size: var(--fs-sm);
    transition: color var(--dur) var(--ease);
  }

  .footer__col a:hover {
    color: var(--c-text-invert);
  }

  .footer__visit {
    display: grid;
    align-content: start;
    gap: var(--space-5);
  }

  .footer__visit .footer__heading {
    margin-bottom: 0;
  }

  .footer__store {
    display: grid;
    gap: 0.1rem;
    font-style: normal;
    font-size: var(--fs-sm);
    color: var(--c-text-invert-muted);
  }

  .footer__store a.footer__store-name {
    font-family: var(--font-display);
    font-size: var(--fs-md);
    color: var(--c-text-invert);
    margin-bottom: 0.2rem;
  }

  .footer__store a.footer__phone {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    margin-block: 0.35rem 0.25rem;
    color: var(--c-text-invert);
    font-weight: 600;
  }

  .footer__store :global(.status) {
    color: var(--c-text-invert-muted);
  }

  .footer__hours {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-top: var(--space-8);
    padding-block: var(--space-5);
    border-top: 1px solid var(--c-ink-line);
    color: var(--c-brass-light);
  }

  .footer__hours dl {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-7);
    font-size: var(--fs-sm);
  }

  .footer__hours dl div {
    display: flex;
    gap: var(--space-3);
  }

  .footer__hours dt {
    color: var(--c-text-invert-muted);
  }

  .footer__hours dd {
    color: var(--c-text-invert);
    font-weight: 550;
  }

  .footer__bottom {
    border-top: 1px solid var(--c-ink-line);
    background: #14110f;
  }

  .footer__bottom-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3) var(--space-6);
    padding-block: var(--space-5);
    font-size: var(--fs-xs);
    color: var(--c-text-invert-muted);
  }

  .footer__bottom-links {
    display: flex;
    gap: var(--space-5);
  }

  .footer__bottom a {
    color: var(--c-text-invert-muted);
    text-decoration: none;
  }

  .footer__bottom a:hover {
    color: var(--c-text-invert);
  }

  @media (max-width: 1100px) {
    .footer__grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .footer__brand {
      grid-column: 1 / -1;
    }

    .footer__visit {
      grid-column: 1 / -1;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    }

    .footer__visit .footer__heading {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 640px) {
    .site-footer {
      padding-top: var(--space-8);
      padding-bottom: 72px; /* room for the mobile action bar */
    }

    .footer__grid {
      grid-template-columns: 1fr 1fr;
    }

    .footer__hours {
      align-items: flex-start;
    }
  }
</style>
