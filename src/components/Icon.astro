---
/**
 * Minimal inline SVG icon set (24×24, stroke-based unless noted).
 * Usage: <Icon name="phone" size={18} />
 */
import { icons, type IconName } from '../data/icons';

export type { IconName };
interface Props {
  name: IconName;
  size?: number;
  class?: string;
  label?: string;
  strokeWidth?: number;
}

const { name, size = 20, class: className, label, strokeWidth = 1.7 } = Astro.props;
const body = icons[name];
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={['icon', `icon-${name}`, className]}
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
  set:html={body}
/>
