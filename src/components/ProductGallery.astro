---
/**
 * The photo area at the top of a model page: a gallery of the model's photos (src/data/productPhotos.ts), or the
 * labelled placeholder with where to see the model meanwhile. Photos published from HMI mode in this browser replace
 * it as a preview (src/scripts/productPhotos.ts).
 */
import Photo from './Photo.astro';
import { photosFor } from '../data/productPhotos';
import { productPath, type Product } from '../data/products';
import { withBase } from '../scripts/url';

interface Props {
  product: Product;
  /** Brand and model, e.g. "Heat & Glo Mezzo 48" */
  name: string;
  brand: string;
  /** The /go/ link, when the manufacturer's page is working */
  outbound?: string;
  /** Showrooms with one on the floor */
  stores: { name: string; href: string }[];
}

const { product: p, name, brand, outbound, stores } = Astro.props;
const photos = photosFor(p);
const total = photos.length;
---

<div class="gallery" data-gallery data-gallery-for={p.id} data-gallery-name={name}>
  <div class="gallery__slides">
    {
      total ? (
        photos.map((photo, i) => (
          <figure class="gallery__slide" data-slide={i} hidden={i > 0}>
            <div class="gallery__frame">
              <Photo src={photo.src} alt={photo.alt} sizes="(min-width: 960px) 560px, 100vw" loading={i ? 'lazy' : 'eager'} fetchpriority={i ? undefined : 'high'} />
            </div>
            {(photo.caption || photo.credit) && <figcaption class="gallery__caption">{[photo.caption, photo.credit].filter(Boolean).join(' · ')}</figcaption>}
          </figure>
        ))
      ) : (
        <figure class="gallery__slide" data-slide="0">
          <div class="gallery__frame gallery__frame--placeholder">
            <img src={withBase(`${productPath(p)}photo.svg`)} alt={`Photo coming soon: ${name}`} width="800" height="600" decoding="async" />
          </div>
        </figure>
      )
    }
  </div>
  {
    total > 1 && (
      <ul class="gallery__thumbs" role="list">
        {photos.map((photo, i) => (
          <li>
            <button type="button" class="gallery__thumb" data-show={i} aria-pressed={i === 0 ? 'true' : 'false'}>
              <Photo src={photo.src} alt="" sizes="80px" widths={[160]} />
              <span class="visually-hidden">
                Photo {i + 1} of {total}: {photo.alt}
              </span>
            </button>
          </li>
        ))}
      </ul>
    )
  }
  {
    !total && (outbound || stores.length > 0) && (
      <p class="gallery__note">
        {/* prettier-ignore */}
        See it {outbound && <a href={outbound} target="_blank" rel="noopener" data-outbound>on {brand}’s site<span class="visually-hidden"> (opens in a new tab)</span></a>}{outbound && stores.length > 0 && ' or '}{stores.length > 0 && 'on the showroom floor in '}{stores.map((s, i) => <>{i > 0 && ' and '}<a href={s.href}>{s.name}</a></>)}.
      </p>
    )
  }
</div>

<script>
  import { initProductPhotos } from '../scripts/productPhotos';
  initProductPhotos();
</script>

<style is:global>
  /* Global: a preview built in the browser (src/scripts/productPhotos.ts) uses the same classes */
  .gallery {
    display: grid;
    gap: var(--space-3);
    min-width: 0;
  }

  .gallery__slide {
    display: grid;
    gap: var(--space-2);
    margin: 0;
  }

  .gallery__slide[hidden] {
    display: none;
  }

  .gallery__frame {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: #120d0b;
    box-shadow: 0 30px 60px -25px rgb(0 0 0 / 0.7);
  }

  .gallery__frame img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .gallery__frame--placeholder {
    background: #efe5d6;
  }

  .gallery__frame--placeholder img {
    object-fit: cover;
  }

  .gallery__caption,
  .gallery__note {
    font-size: var(--fs-xs);
    color: var(--c-text-invert-muted);
  }

  .gallery__note a {
    color: var(--c-flame);
    font-weight: 600;
    text-underline-offset: 3px;
  }

  .gallery__note a:hover {
    color: #ffd29a;
  }

  .gallery__note--preview {
    padding: var(--space-2) var(--space-3);
    border: 1px dashed rgb(240 160 75 / 0.55);
    border-radius: var(--radius);
    background: rgb(240 160 75 / 0.1);
    color: var(--c-text-invert);
  }

  .gallery__thumbs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .gallery__thumb {
    display: block;
    width: 72px;
    aspect-ratio: 4 / 3;
    padding: 0;
    overflow: hidden;
    border: 2px solid transparent;
    border-radius: 8px;
    background: #120d0b;
    cursor: pointer;
    opacity: 0.7;
    transition: opacity 0.15s ease, border-color 0.15s ease;
  }

  .gallery__thumb:hover,
  .gallery__thumb[aria-pressed='true'] {
    opacity: 1;
  }

  .gallery__thumb[aria-pressed='true'] {
    border-color: var(--c-flame);
  }

  .gallery__thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery__thumb {
      transition: none;
    }
  }
</style>
