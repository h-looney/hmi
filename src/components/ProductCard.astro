---
/** A model on a category page or in "more like this": photo, brand, model, type and where it's on display. */
import ProductImage from './ProductImage.astro';
import { brands } from '../data/brands';
import { brandSites, productPath, type Product } from '../data/products';
import { locations } from '../data/site';
import { withBase } from '../scripts/url';

interface Props {
  product: Product;
  headingLevel?: 'h2' | 'h3';
}

const { product: p, headingLevel: H = 'h3' } = Astro.props;
const brand = brandSites[p.brand]?.name ?? brands.find((b) => b.id === p.brand)?.name ?? p.brand;
const onDisplay = locations.filter((l) => (p.display[l.slug as keyof typeof p.display] ?? 0) > 0).map((l) => l.shortName);
---

<article class="card card--hover model-card" data-listing-card={p.id}>
  <div class="card__media model-card__media" data-product-photo={p.id}>
    <ProductImage product={p} sizes="(min-width: 1240px) 300px, (min-width: 700px) 45vw, 100vw" />
  </div>
  <div class="card__body model-card__body">
    <p class="model-card__brand">{brand}</p>
    <H class="model-card__title">
      <a href={withBase(productPath(p))} class="card__link" data-listing-model>{p.model}</a>
    </H>
    <p class="model-card__type" data-listing-type>{p.type}</p>
    {
      p.status === 'discontinued' ? (
        <p class="model-card__note">No longer made · service &amp; parts</p>
      ) : onDisplay.length ? (
        <p class="model-card__note model-card__note--display">On display in {onDisplay.join(' & ')}</p>
      ) : (
        <p class="model-card__note">Ask us — we can order it</p>
      )
    }
  </div>
</article>

<script>
  // Photos and listing changes published from HMI mode in this browser show here as a preview
  import { cardEdits } from '../scripts/listingPreview';
  import { initProductPhotos } from '../scripts/productPhotos';
  initProductPhotos();
  void cardEdits(document);
</script>

<style is:global>
  /* Global: listings published from HMI mode build these cards in the browser (src/scripts/listingPreview.ts) */
  .model-card__media {
    --ratio: 4 / 3;
  }

  .model-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .model-card__body {
    gap: var(--space-1);
  }

  .model-card__brand {
    font-size: var(--fs-2xs);
    font-weight: 650;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-brass-text);
  }

  .model-card__title {
    font-size: var(--fs-lg);
    line-height: 1.25;
  }

  .model-card__type {
    font-size: var(--fs-sm);
    color: var(--c-text-muted);
  }

  .model-card__note {
    margin-top: var(--space-2);
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--c-text-muted);
  }

  .model-card__note--display {
    color: var(--c-ember-700);
  }

  .model-card__preview {
    justify-self: start;
    margin-top: var(--space-2);
    padding: 0.15em 0.6em;
    border-radius: var(--radius-pill);
    background: var(--c-ember-50);
    color: var(--c-ember-700);
    font-size: var(--fs-2xs);
    font-weight: 650;
  }
</style>
