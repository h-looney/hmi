---
import Icon from './Icon.astro';
import OpenStatus from './OpenStatus.astro';
import LazyMap from './LazyMap.astro';
import { site, tel, prettyPhone, type Location } from '../data/site';
import { withBase } from '../scripts/url';

interface Props {
  location: Location;
  showMap?: boolean;
  headingLevel?: 'h2' | 'h3';
}

const { location: l, showMap = true, headingLevel: H = 'h3' } = Astro.props;
---

<article class="loc-card" data-reveal>
  {showMap && <LazyMap src={l.mapEmbed} title={`Map of ${l.name}`} label={`${l.shortName} showroom`} />}
  <div class="loc-card__body">
    <div class="loc-card__head">
      <p class="eyebrow eyebrow--plain">{l.region}</p>
      <H class="loc-card__title">
        <a href={withBase(`/locations/${l.slug}/`)}>{l.shortName}, Missouri</a>
      </H>
      <OpenStatus location={l} />
    </div>

    <dl class="loc-card__details">
      <div>
        <dt><Icon name="pin" size={18} /><span class="visually-hidden">Address</span></dt>
        <dd>
          <address>
            {l.street}<br />{`${l.city}, ${l.state} ${l.zip}`}
          </address>
        </dd>
      </div>
      <div>
        <dt><Icon name="phone" size={18} /><span class="visually-hidden">Phone</span></dt>
        <dd>
          <a href={tel(l.phone)} class="loc-card__phone tabular">{prettyPhone(l.phone)}</a>
          <span class="muted small tabular">Toll-free {prettyPhone(l.tollFree)} · Fax {prettyPhone(l.fax)}</span>
        </dd>
      </div>
      <div>
        <dt><Icon name="clock" size={18} /><span class="visually-hidden">Hours</span></dt>
        <dd>
          <ul role="list" class="loc-card__hours">
            {
              site.hoursSummary.map((h) => (
                <li>
                  <span>{h.days}</span>
                  <span>{h.time}</span>
                </li>
              ))
            }
          </ul>
        </dd>
      </div>
    </dl>

    <div class="loc-card__actions">
      <a href={tel(l.phone)} class="btn btn--primary btn--sm">
        <Icon name="phone" size={16} /> Call {l.shortName}
      </a>
      <a href={l.directionsUrl} class="btn btn--outline btn--sm" target="_blank" rel="noopener">
        <Icon name="pin" size={16} /> Directions
      </a>
    </div>
  </div>
</article>

<style>
  .loc-card {
    display: grid;
    background: var(--c-paper);
    border: 1px solid var(--c-stone);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }

  .loc-card__body {
    display: grid;
    gap: var(--space-5);
    padding: clamp(1.25rem, 1rem + 1vw, 2rem);
  }

  .loc-card__head {
    display: grid;
    gap: var(--space-2);
  }

  .loc-card__title {
    font-size: var(--fs-xl);
  }

  .loc-card__title a {
    color: inherit;
    text-decoration: none;
  }

  .loc-card__title a:hover {
    color: var(--c-ember);
  }

  .loc-card__head :global(.status) {
    color: var(--c-text-muted);
  }

  .loc-card__details {
    display: grid;
    gap: var(--space-4);
  }

  .loc-card__details > div {
    display: grid;
    grid-template-columns: 28px 1fr;
    gap: var(--space-3);
  }

  .loc-card__details dt {
    color: var(--c-ember);
    padding-top: 0.15em;
  }

  .loc-card__details dd {
    display: grid;
    gap: 0.15rem;
  }

  .loc-card__details address {
    font-style: normal;
  }

  .loc-card__phone {
    font-weight: 650;
    font-size: var(--fs-md);
    color: var(--c-text);
    text-decoration: none;
  }

  .loc-card__phone:hover {
    color: var(--c-ember);
  }

  .loc-card__hours {
    display: grid;
    gap: 0.2rem;
    padding: 0;
    list-style: none;
    font-size: var(--fs-sm);
  }

  .loc-card__hours li {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    max-width: 340px;
  }

  .loc-card__hours li span:first-child {
    color: var(--c-text-muted);
  }

  .loc-card__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
</style>
