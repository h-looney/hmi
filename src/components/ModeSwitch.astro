---
/**
 * Concept-demo switch between the public website and HMI mode (the staff app at /office/).
 * Not part of the real site — in production, staff would use the "Staff sign-in" link instead.
 */
import Icon from './Icon.astro';
import { withBase } from '../scripts/url';
---

<nav class="mode-switch no-print" aria-label="Demo: switch between the public site and HMI mode">
  <span class="mode-switch__label" aria-hidden="true">Demo</span>
  <span class="mode-switch__opt is-active" aria-current="page">
    <Icon name="home" size={15} />
    Public
  </span>
  <a class="mode-switch__opt" href={withBase('/office/?signin')} data-mode-hmi>
    <Icon name="briefcase" size={15} />
    HMI mode
  </a>
</nav>

<script>
  // Remember where the visitor is, so "Public" in HMI mode brings them back here — and send
  // "HMI mode" back to wherever they last were in the staff app. ?signin opens the profile picker
  // there first, so each visit to HMI mode starts by choosing who to be.
  try {
    localStorage.setItem('hmi-last-public', location.pathname + location.search + location.hash);
    const lastOffice = localStorage.getItem('hmi-last-office');
    const link = document.querySelector<HTMLAnchorElement>('[data-mode-hmi]');
    if (link && lastOffice && lastOffice.startsWith(new URL(link.href).pathname)) link.href = `${lastOffice}${lastOffice.includes('?') ? '&' : '?'}signin`;
  } catch {
    /* storage unavailable */
  }
</script>

<style>
  .mode-switch {
    position: fixed;
    left: 16px;
    bottom: 16px;
    z-index: 80;
    display: inline-flex;
    align-items: center;
    gap: 2px;
    padding: 4px;
    border-radius: var(--radius-pill);
    background: rgb(27 23 20 / 0.92);
    backdrop-filter: blur(10px);
    box-shadow:
      0 12px 30px -10px rgb(0 0 0 / 0.55),
      0 0 0 1px rgb(255 255 255 / 0.08);
    font-size: var(--fs-xs);
  }

  .mode-switch__label {
    padding: 0 6px 0 10px;
    color: var(--c-flame);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .mode-switch__opt {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 32px;
    padding: 0 12px;
    border-radius: var(--radius-pill);
    color: var(--c-text-invert);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  .mode-switch__opt.is-active {
    background: var(--c-cream);
    color: var(--c-ink);
  }

  a.mode-switch__opt:hover {
    background: rgb(255 255 255 / 0.1);
    color: #fff;
  }

  a.mode-switch__opt :global(.icon) {
    color: var(--c-flame);
  }

  @media (max-width: 640px) {
    /* Sit above the phone action bar */
    .mode-switch {
      left: 10px;
      bottom: calc(74px + env(safe-area-inset-bottom));
    }
  }

  @media print {
    .mode-switch {
      display: none;
    }
  }
</style>
